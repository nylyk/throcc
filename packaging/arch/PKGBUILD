pkgname=throcc
pkgver=0.1.0
pkgrel=1
pkgdesc='Self-hosted voice and screen share, end-to-end encrypted'
arch=('x86_64' 'aarch64')
url='https://github.com/nylyk/throcc'
license=('AGPL-3.0-or-later' 'LGPL-2.1-or-later')
depends=('alsa-lib' 'dav1d' 'dbus' 'fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'libpipewire' 'libva' 'libvpx'
         'libx11' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland'
         'xdg-desktop-portal')
makedepends=('clang' 'ffnvcodec-headers' 'git' 'nasm' 'pkgconf' 'rust-bindgen' 'rustup')
optdepends=('mesa: VA-API video encoding on AMD GPUs'
            'intel-media-driver: VA-API video encoding on Intel GPUs'
            'nvidia-utils: NVENC video encoding on NVIDIA GPUs')
options=('!lto')
_ffmpeg=8.1.3
source=("throcc::git+${THROCC_GIT:-https://github.com/nylyk/throcc.git}"
        "https://ffmpeg.org/releases/ffmpeg-$_ffmpeg.tar.xz")
sha256sums=('SKIP'
            '7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3')

pkgver() {
    cd throcc
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd throcc
    FFMPEG_TARBALL="$srcdir/ffmpeg-$_ffmpeg.tar.xz" packaging/ffmpeg/build.sh "$srcdir/ffmpeg"
    packaging/ffmpeg/bindings.sh "$srcdir/ffmpeg" "$srcdir/ffmpeg/binding.rs"
    export FFMPEG_DLL_PATH="$srcdir/ffmpeg/lib"
    export FFMPEG_BINDING_PATH="$srcdir/ffmpeg/binding.rs"
    export RUSTFLAGS="-C link-arg=-Wl,--disable-new-dtags,-rpath,/usr/lib/throcc"
    cargo build --release --locked -p throcc-client --features ffmpeg
    cargo build --release --locked -p throcc-cli
}

package() {
    cd throcc
    install -Dm755 target/release/throcc-client "$pkgdir/usr/bin/throcc"
    install -Dm755 target/release/throcc-cli "$pkgdir/usr/bin/throcc-cli"
    install -dm755 "$pkgdir/usr/lib/throcc"
    cp -P "$srcdir"/ffmpeg/lib/lib*.so* "$pkgdir/usr/lib/throcc/"
    install -Dm644 packaging/arch/throcc.desktop "$pkgdir/usr/share/applications/throcc.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/throcc/LICENSE"
}
